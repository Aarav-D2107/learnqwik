# =============================================================
# LearnQwik — FRONTEND environment (Vercel / local)
#
# EVERYTHING HERE IS PUBLIC. It is compiled into js/env.js and
# shipped to the browser, where anyone can read it.
#
# NEVER put these in this file:
#   AI_API_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   any backend secret
# =============================================================

# Your FastAPI backend. No trailing slash.
#   local:      http://localhost:8000
#   production: https://YOUR-LEARNQWIK-BACKEND.onrender.com
API_BASE_URL=http://localhost:8000

# Alias accepted by build.js, for parity with a future Next.js migration.
# NEXT_PUBLIC_API_URL=

# NOTE: LearnQwik does NOT need NEXT_PUBLIC_SUPABASE_URL or
# NEXT_PUBLIC_SUPABASE_ANON_KEY in the browser. Authentication is proxied
# through the backend (POST /api/auth/login), so no Supabase credential is
# exposed client-side at all. See docs/ARCHITECTURE.md for why.
