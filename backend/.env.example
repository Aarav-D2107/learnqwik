# =============================================================
# LearnQwik — BACKEND environment (Render / local)
# These are SERVER-SIDE ONLY. None of them belong in the browser.
# Copy to .env and fill in. Never commit .env.
# =============================================================

ENVIRONMENT=development

# ---------- Supabase ----------
# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# SECRET. Bypasses Row Level Security. Backend only — never in Vercel, never in JS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

STORAGE_BUCKET=learnqwik-documents

# ---------- AI provider ----------
# openai | openai-compatible
AI_PROVIDER=openai-compatible

AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.groq.com/openai/v1

TEXT_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.6-27b

# Optional. Only needed if USE_EMBEDDINGS=true (requires pgvector).
EMBEDDING_MODEL=

# Optional. For self-hosted / proxied OpenAI-compatible endpoints.
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=2000

# ---------- Networking / CORS ----------
# The exact origin of your deployed frontend. No trailing slash.
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# Optional comma-separated extra origins
EXTRA_CORS_ORIGINS=

# ---------- Quiz rules ----------
SECONDS_PER_QUESTION=60
MAX_FULLSCREEN_VIOLATIONS=3
REASSESS_QUESTION_COUNT=4
MIN_QUESTIONS_PER_QUIZ=5
MAX_QUESTIONS_PER_QUIZ=10

# ---------- Scoring ----------
DIFFICULTY_WEIGHT_EASY=1.0
DIFFICULTY_WEIGHT_MEDIUM=1.5
DIFFICULTY_WEIGHT_HARD=2.0

RECENT_WEIGHT=0.7
HISTORICAL_WEIGHT=0.3

MASTERY_BAND_WEAK_MAX=39
MASTERY_BAND_STRUGGLING_MAX=59
MASTERY_BAND_DEVELOPING_MAX=79

WEAK_TOPIC_THRESHOLD=60

# ---------- Recommendation weights ----------
# Must sum to 1.0

REC_W_TOPIC_RELEVANCE=0.40
REC_W_DIFFICULTY_MATCH=0.20
REC_W_QUALITY=0.15
REC_W_FORMAT_PREFERENCE=0.15
REC_W_DURATION_FIT=0.10

# ---------- Uploads / document AI cost control ----------
MAX_UPLOAD_SIZE_MB=20
MAX_VISION_PAGES=12
VISION_RENDER_DPI=130

CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=150

RETRIEVAL_TOP_K=6

# Leave false unless you have enabled pgvector AND set EMBEDDING_MODEL.
USE_EMBEDDINGS=false

# ---------- Abuse protection ----------
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=30